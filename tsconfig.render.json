{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src/preload/render.ts",
    "src/render/**/*",
    "src/shared/**/*",
    "tests/render/**/*",
    "src/renderer/src/**/*",
    "src/preload/*.d.ts"
  ]
}
